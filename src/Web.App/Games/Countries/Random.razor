@using Web.App.Games.Components
@using Web.App.Settings

@page "/countries/random/{cca2?}"
@inject AppLocalizer Localizer

<CascadingValue Value="_gameState" IsFixed="false">
	<main class="game">
		<Scoreboard Score="_score" Icon="flag-fill" Title="@Localizer.UnlimitedCountry" Subtitle="@Localizer.Endless" Label="@Localizer.ChaseYourStreak" />
		<div class="quack-card">
			@if (_isLoading)
			{
				<div class="game-spinner">
					<span class="quack-spinner quack-spinner-lg quack-spinner-accent"></span>
					<span class="text">@Localizer.LoadingGame</span>
				</div>
			}
			else if (_hasError)
			{
				<div class="error-state">
					<span class="icon"><i class="bi bi-wifi-off"></i></span>
					<span class="title">@Localizer.CouldNotLoadGame</span>
					<span class="text">@Localizer.FailedFetchingGame</span>
					<div class="actions">
						<button type="button" class="quack-btn quack-btn-primary" @onclick="FetchGameAsync">
							<i class="bi bi-arrow-clockwise"></i>
							@Localizer.Retry
						</button>
					</div>
				</div>
			}
			else
			{
				@if (State.Country != CountryDifficulty.None && !_gameState.GameFinished)
				{
					<div class="difficulty">
						<span class="label">@Localizer.Difficulty</span>
						@if ((State.Country & CountryDifficulty.Blur) != 0)
						{
							<span class="quack-chip quack-chip-primary">
								<i class="bi bi-circle-half"></i>
								@Localizer.Blur
							</span>
						}
						@if ((State.Country & CountryDifficulty.Rotated) != 0)
						{
							<span class="quack-chip quack-chip-primary">
								<i class="bi bi-arrow-clockwise"></i>
								@Localizer.Rotated
							</span>
						}
						@if ((State.Country & CountryDifficulty.Mirrored) != 0)
						{
							<span class="quack-chip quack-chip-primary">
								<i class="bi bi-symmetry-vertical"></i>
								@Localizer.Mirror
							</span>
						}
					</div>
				}
				<div class="country">
					<div class="wrapper">
						@if (_gameState.Country is null)
						{
							<div class="country-not-found">
								<i class="bi bi-image-alt"></i>
								<span class="text">@Localizer.FlagFailed</span>
								<button type="button" class="quack-btn quack-btn-secondary quack-btn-sm" @onclick="FetchGameAsync">
									<i class="bi bi-arrow-clockwise"></i>
									@Localizer.Retry
								</button>
							</div>
						}
						else
						{
							<div class="background">
								<img src="@_gameState.Country.Resources.Country" style="@DifficultyCss" />
							</div>
						}
					</div>
				</div>
				<span class="question">@Localizer.WhichCountryHasThisShape</span>
				@if (!_gameState.GameFinished && State.FlagHint)
				{
					<div class="flag-hint">
						@if (!_flagHint)
						{
							<button type="button" class="quack-btn quack-btn-secondary quack-btn-sm" @onclick="() => _flagHint = true">
								<i class="bi bi-flag"></i>
								@Localizer.ShowFlagHint
							</button>
						}
						else
						{
							<span class="label">@Localizer.FlagHint</span>
							<img src="@_gameState.Country!.Resources.Flag" />
						}
					</div>
				}
				@if (_gameState.GameFinished)
				{
					<GameOver Preview="State.Country != CountryDifficulty.None" OnPreviewClick="(preview) => _preview = preview">
						<button type="button" class="quack-btn quack-btn-primary quack-btn-lg" @onclick="PlayAgainAsync">
							@Localizer.PlayAgain
							<i class="bi bi-arrow-right"></i>
						</button>
					</GameOver>
				}
				else
				{
					<CountryInput @ref="_input" OnLookup="GuessAsync" />
					<GameActions OnGiveUp="GiveUp" />
				}
			}
		</div>
		<Guesses />
	</main>
</CascadingValue>
