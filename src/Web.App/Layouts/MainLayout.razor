@using Web.App.Options

@inherits LayoutComponentBase

@inject AppLocalizer Localizer
@inject ProjectOptions Project

<header>
	<a href="/" class="logo" aria-label="@Localizer.Home">
		<img src="assets/atlas.webp" alt="@Localizer.Logo" />
		<span class="title">@Localizer.Atlas</span>
	</a>
	<nav>
		<a href="@Project.Url" target="_blank" class="quack-icon-btn quack-icon-btn-pill" data-tooltip="@Localizer.AtlasGitHub" data-tooltip-position="bottom" aria-label="@Localizer.AtlasGitHub">
			<i class="bi bi-github"></i>
		</a>
		<button type="button" class="quack-icon-btn quack-icon-btn-pill" popovertarget="feedback" data-tooltip="@Localizer.SendFeedback" data-tooltip-position="bottom" aria-label="@Localizer.SendFeedback">
			<i class="bi bi-chat-left"></i>
		</button>
		<button type="button" class="quack-icon-btn quack-icon-btn-pill" commandfor="settings" command="--general" data-tooltip="@Localizer.Settings" data-tooltip-position="bottom-end" aria-label="@Localizer.Settings">
			<i class="bi bi-gear"></i>
		</button>
	</nav>
</header>
@Body
<footer>
	<div class="wrapper">
		<div class="copyright">
			<svg width="24" height="24" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
				<circle cx="50" cy="50" r="47" fill="#085041" stroke="#5DCAA5" stroke-width="5" />
				<rect x="20" y="46" width="46" height="32" rx="14" fill="#9FE1CB" />
				<rect x="32" y="22" width="38" height="32" rx="12" fill="#5DCAA5" />
				<rect x="64" y="30" width="20" height="10" rx="5" fill="#AFA9EC" />
				<circle cx="56" cy="32" r="5.5" fill="#0a0a0f" />
				<circle cx="57.8" cy="30.2" r="2" fill="white" />
				<rect x="32" y="60" width="18" height="10" rx="5" fill="#1D9E75" />
			</svg>
			<span class="kappaduck">
				&copy; @DateTime.Now.Year <a href="@Project.CompanyUrl" target="_blank" class="company">Kappa<span class="duck">Duck</span></a>
			</span>
		</div>
		<button type="button" class="changelog" data-tooltip="@Localizer.ViewChangelog">@Project.Version</button>
	</div>
</footer>

<div id="feedback" class="quack-popover" popover="auto">
	<div class="feedback">
		<div class="title">
			<strong>@Localizer.SendFeedback</strong>
			<span>@Localizer.OpenIssue</span>
		</div>
		<div class="links">
			<a href="@Project.BugUrl" target="_blank" class="quack-btn quack-btn-secondary quack-btn-block">
				<i class="bi bi-bug"></i>@Localizer.ReportBug
			</a>
			<a href="@Project.FeatureUrl" target="_blank" class="quack-btn quack-btn-secondary quack-btn-block">
				<i class="bi bi-lightbulb"></i>@Localizer.RequestFeature
			</a>
		</div>
		<a href="@Project.IssuesUrl" target="_blank" class="quack-link">@Localizer.BrowseIssues</a>
	</div>
</div>
