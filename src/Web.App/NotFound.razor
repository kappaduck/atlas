@page "/not-found"
@layout MainLayout

@inject AppLocalizer Localizer

<PageTitle>404 &mdash; @Localizer.Atlas</PageTitle>

<main class="not-found">
	<span class="header-404">404</span>
	<div class="content-404">
		<span class="subtitle">@Localizer.LostAtSea</span>
		<h1>@Localizer.PlaceNotOnMap</h1>
		<p class="description">@Localizer.NotFoundMessage</p>
	</div>
	<a href="/" class="quack-btn quack-btn-primary quack-btn-lg quack-btn-pill">@Localizer.BackToHome</a>
</main>
