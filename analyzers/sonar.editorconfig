is_global = true

# S1481: Unused local variables should be removed
# Is a duplicate of IDE0059: https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/ide0059
dotnet_diagnostic.S1481.severity = none

# S3903: Move type into a named namespace.
# This rule does not apply to file-based code
dotnet_diagnostic.S3903.severity = none

# S8970: Remove this null-forgiving operator; nullabe warnings are disabled here.
# The analyzer conflict with microsoft analyzer
dotnet_diagnostic.S8970.severity = none
